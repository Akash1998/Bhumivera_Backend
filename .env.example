# Copy this file to .env and fill in actual values for your local MySQL instance.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bhumivera
DB_PORT=3306
# TLS certificate verification is enabled by default. Only disable locally.
DB_SSL=true
# Optional PEM CA bundle for providers that use a private database CA.
DB_SSL_CA=
# Backend-to-MySQL pool cap; keeps up to two connections warm to limit request latency.
DB_POOL_SIZE=5
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Use an independent random secret for HMAC-protected OTPs.
OTP_SECRET=replace_with_a_different_long_random_secret
# Required for admin-managed courier API credentials; generate 32 random bytes and hex-encode them.
CARRIER_CREDENTIALS_KEY=replace_with_64_hex_characters
# Optional; production defaults to .bhumivera.com when requests use that host.
TRUSTED_DEVICE_COOKIE_DOMAIN=
NODE_ENV=development
PORT=5000
# Comma-separated exact browser origins; configure deployed frontend domains in production.
FRONTEND_ORIGINS=https://www.bhumivera.com,https://bhumivera.com,http://localhost:5173,http://localhost:3000
# Optional frontend base URL used for staff-triggered customer password-reset links.
FRONTEND_URL=https://www.bhumivera.com
# Optional for a single backend instance. Configure the same Redis URL on every
# backend instance to share rate-limit counters when horizontally scaled.
RATE_LIMIT_REDIS_URL=
# Optional shared Redis response cache. Falls back to RATE_LIMIT_REDIS_URL when unset.
CACHE_REDIS_URL=

# Bhumivera AI Engine & Gemini Configuration (Project: projects/670352821091)
GEMINI_API_KEY=AQ.Ab8RN6I82r-Ei7Ek7uVPuivG8LDubsuH_FnXScPNtujMPTF4iw
BHUMIVERA_API_KEY_AI_ENGINE=AQ.Ab8RN6I82r-Ei7Ek7uVPuivG8LDubsuH_FnXScPNtujMPTF4iw
GOOGLE_CLOUD_PROJECT=670352821091
GEMINI_MODEL=gemini-2.5-flash

# Optional third-party integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional until a Razorpay webhook endpoint is configured in the provider dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Autonomous AI Customer Support & Escalation Webhooks
SUPPORT_FRUSTRATION_THRESHOLD=70
SUPPORT_ESCALATION_EMAIL=support@bhumivera.com
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=
# Incoming bot updates use API_BASE_URL by default; override with the full HTTPS webhook URL if needed.
SUPPORT_TELEGRAM_INCOMING_WEBHOOK_URL=
SUPPORT_TELEGRAM_WEBHOOK_SECRET=
# Outgoing escalation notifications (Telegram sendMessage API URL).
SUPPORT_TELEGRAM_WEBHOOK_URL=
SUPPORT_WHATSAPP_WEBHOOK_URL=
SUPPORT_WHATSAPP_TOKEN=
