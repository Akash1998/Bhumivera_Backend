{
  "name": "Bhumivera-backend",
  "version": "1.1.0",
  "description": "Bhumivera Backend API - E-commerce Core with AI Integration",
  "main": "server",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server",
    "dev": "nodemon server",
    "lint": "eslint .",
    "test": "node --test",
    "smoke": "node scripts/smokeTest",
    "veo:list": "node scripts/generateConciergeVeoVideos.js --list",
    "veo:dry-run": "node scripts/generateConciergeVeoVideos.js --dry-run --all",
    "veo:generate": "node scripts/generateConciergeVeoVideos.js --all",
    "seed:luxury": "node scripts/seedLuxuryCatalog.js",
    "seed:reviews": "node scripts/seedReviews.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "mysql",
    "aws-s3",
    "pinecone",
    "express"
  ],
  "author": "Akash Prasad",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@google/genai": "^2.29.1",
    "@huggingface/transformers": "^4.3.1",
    "@pinecone-database/pinecone": "^9.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "redis": "^6.3.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "nodemon": {
      "chokidar": "^4.0.3"
    },
    "@otplib/plugin-base32-scure": {
      "@scure/base": "1.2.6"
    },
    "@otplib/plugin-crypto-noble": {
      "@noble/hashes": "1.8.0"
    }
  }
}
