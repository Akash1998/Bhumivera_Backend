{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/inventory-software/backup/cron-daily",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/auth(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(products|categories|subcategories|flash-sales)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
