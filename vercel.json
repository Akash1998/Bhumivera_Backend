{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(products|categories|subcategories|flash-sales)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=15, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
